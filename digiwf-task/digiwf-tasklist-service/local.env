###############################################################################
# Environment variables to run task list service locally,
# using docker compose stack for backing services.
###############################################################################

#
# DB configuration
#
DATASOURCE_URL=jdbc:postgresql://localhost:25432/tasklistdb
DATASOURCE_USERNAME=user
DATASOURCE_PASSWORD=secret
JPA_PLATFORM=io.muenchendigital.digiwf.task.service.persistence.NoToastPostgresSQLDialect

#
# Kafka Configuration
#
KAFKA_BOOTSTRAP_SERVER=localhost
KAFKA_BOOTSTRAP_SERVER_PORT=29092
KAFKA_SECURITY_PROTOCOL_CONFIG=PLAINTEXT

KAFKA_TOPIC_TASKS=polyflow-tasks
KAFKA_TOPIC_DATA_ENTRIES=polyflow-data

#
# SSO
#
SSO_ISSUER_URL=localhost:18080/auth/realms/P82
