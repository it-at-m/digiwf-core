###############################################################################
# Global settings docker compose stack for backing services.
###############################################################################

#
# Kafka Configuration
#
KAFKA_BOOTSTRAP_SERVER=localhost
KAFKA_BOOTSTRAP_SERVER_PORT=29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

#
# SSO
#
SSO_BASE_URL=http://localhost:18080/auth
SSO_REALM=P82
SSO_ISSUER_URL=${SSO_BASE_URL}/realms/${SSO_REALM}

###############################################################################
# Environment variables to run task list service locally,
# using docker compose stack for backing services.
###############################################################################

#
# DB configuration
#
TASK_DATASOURCE_URL=jdbc:postgresql://localhost:25432/tasklistdb
TASK_DATASOURCE_USERNAME=user
TASK_DATASOURCE_PASSWORD=secret
TASK_JPA_PLATFORM=io.muenchendigital.digiwf.task.service.persistence.NoToastPostgresSQLDialect

#
# Kafka
#
KAFKA_TOPIC_TASKS=dfw-taskmanagement-tasks-local-01
KAFKA_TOPIC_DATA_ENTRIES=dfw-taskmanagement-data-local-01

#
# SSO
#
SSO_TASK_CLIENT_ID=task-management
