    <bpmn:scriptTask id="ScriptTask_Prozessvariablen_setzen" name="Prozessvariablen setzen" camunda:asyncBefore="true" scriptFormat="javascript">
      <bpmn:incoming>Flow_008fnlg</bpmn:incoming>
      <bpmn:outgoing>Flow_00xx18q</bpmn:outgoing>
      <bpmn:script>//**********************************************************
//Antragsteller setzen
execution.getVariable('starterOfInstance');
execution.setVariable('Antragsteller_Vorname', user.firstname(starterOfInstance));
execution.setVariable('Antragsteller_Nachname', user.lastname(starterOfInstance));
execution.setVariable('Antragsteller_Email', user.email(starterOfInstance));


//**********************************************************
//Reisenden setzen
var reisende = '';
var reisendeObjectID = '';
var ou = '';
if (AntragFuerDritte == 'Value_Nein') {
	reisendeObjectID = starterOfInstance;
	ou = user.ou(starterOfInstance);
	reisende = Antragsteller_Vorname + ' ' + Antragsteller_Nachname + ', ' + ou;
}
if (AntragFuerDritte == 'Value_Ja_NurDritte') {
	reisendeObjectID = Dritte;
	ou = user.ou(Dritte);
	reisende = user.firstname(Dritte) + ' ' + user.lastname(Dritte) + ', ' + ou;
}
execution.setVariable('ReisendeInfo', reisende);
execution.setVariable('ReisendeObjectID', reisendeObjectID);
execution.setVariable('Antragsteller_Ou', ou);

execution.setVariable('Antragsteller_Referat', '---');

if (Antragsteller_Ou.toLowerCase().startsWith('itm')) {   execution.setVariable('Antragsteller_Referat', 'ITM')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('rit')) {  execution.setVariable('Antragsteller_Referat', 'RIT')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('por')) { execution.setVariable('Antragsteller_Referat', 'POR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('baed')) { execution.setVariable('Antragsteller_Referat', 'POR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('kvr')) {  execution.setVariable('Antragsteller_Referat', 'KVR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('bau')) { execution.setVariable('Antragsteller_Referat', 'BAU')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('gsr')) { execution.setVariable('Antragsteller_Referat', 'GSR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('kr')) { execution.setVariable('Antragsteller_Referat', 'KR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('kult')) {
execution.setVariable('Antragsteller_Referat', 'KULT')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('mor')) {
execution.setVariable('Antragsteller_Referat', 'MOR')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('raw')) {
execution.setVariable('Antragsteller_Referat', 'RAW')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('rbs')) {
execution.setVariable('Antragsteller_Referat', 'RBS')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('rku')) {
execution.setVariable('Antragsteller_Referat', 'RKU')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('plan')) {
execution.setVariable('Antragsteller_Referat', 'PLAN')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('s-')) {
execution.setVariable('Antragsteller_Referat', 'SOZ')} else {};

if (Antragsteller_Ou.toLowerCase().startsWith('ska')) {
execution.setVariable('Antragsteller_Referat', 'SKA')} else {};

var Antragsteller_Zeile = Antragsteller_Vorname + ' ' + Antragsteller_Nachname;

execution.setVariable('AntragstellerInfo', Antragsteller_Zeile);

execution.setVariable('akrMailPart', null);

execution.setVariable('BefoerderungsmittelZusatz', '');
if (execution.getVariable('BefoerderungsmittelKlasse') != '') {
		execution.setVariable('BefoerderungsmittelZusatz', '; Klasse (Bahn): ' + BefoerderungsmittelKlasse + '\n');
}

execution.setVariable("ErgebnisdokumentDateiname", "Reiseantrag.pdf");

var date_now = new Date();
var month = '' + (date_now.getMonth() + 1);
var day = '' + date_now.getDate();
var year = 1900 + date_now.getYear();
        
if (month.length &lt; 2) 
   month = '0' + month;
if (day.length &lt; 2) 
   day = '0' + day;

var datum = [day, month, year].join('.');
execution.setVariable('Antragsdatum', datum);


//***********************************************************
//Tasktitle setzen
var taskTitle = 'Antragsteller*in: ' + AntragstellerInfo + ' | Reisende*r: ' + ReisendeInfo;
execution.setVariable('TaskTitle', taskTitle);

//***********************************************************
//Prozessbeschreibung setzen
var procDesc = 'Antragsteller*in: ' + AntragstellerInfo + ' | Reisende*r: ' + ReisendeInfo + ' | ' + ArtGenehmigung__detail_name + ' nach ' + ReiseOrt;
process.setDescription(procDesc);</bpmn:script>
    </bpmn:scriptTask>
