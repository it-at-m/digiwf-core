    <bpmn:userTask id="Task_Angaben_korrigieren_Reisesachbearbeitung" name="Reiseantrag freigeben" camunda:formKey="Reiseantrag_Reisesachbearbeitung_V03" camunda:candidateUsers="${responsible_ldap_object_id}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_groups">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_users">true</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_assignee">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_task_description">
            <camunda:script scriptFormat="javascript">//TaskTitle setzen
task_title_ui = TaskTitle;</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="Javascript">//**********************************************************
//Reisenden setzen
var reisende = '';
var reisendeObjectID = '';
var ou = '';
if (AntragFuerDritte == 'Value_Nein') {
	reisende = Antragsteller_Vorname + ' ' + Antragsteller_Nachname;
	reisendeObjectID = starterOfInstance;
	ou = user.ou(starterOfInstance);
}
if (AntragFuerDritte == 'Value_Ja_NurDritte') {
	reisende = user.firstname(Dritte) + ' ' + user.lastname(Dritte);
	reisendeObjectID = Dritte;
	ou = user.ou(Dritte);
}
execution.setVariable('ReisendeInfo', reisende);
execution.setVariable('ReisendeObjectID', reisendeObjectID);
execution.setVariable('Antragsteller_Ou', ou);

//***********************************************************
//Tasktitle setzen
var taskTitle = 'Antragsteller*in: ' + AntragstellerInfo + ' | Reisende*r: ' + ReisendeInfo;
execution.setVariable('TaskTitle', taskTitle);

//***********************************************************
//Prozessbeschreibung setzen
var procDesc = 'Antragsteller*in: ' + AntragstellerInfo + ' | Ort: ' + ReiseOrt + ' | Art der Reise: ' + ArtGenehmigung__detail_name + ' | Reisende*r: ' + ReisendeInfo;
process.setDescription(procDesc);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1x5at09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ocij0t</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_Rueckfrage_E-Mail_versenden" name="Rückfrage-Email versenden" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTask" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="MAILING_REPLY_TO" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME" />
          <camunda:inputParameter name="MAILING_SUBJECT">Ihr Dienstreiseantrag kann nur mit Änderungen freigegeben werden.</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_RECEIVERS">${user.email(starterOfInstance)}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Sehr geehrte*r Kolleg*in,


Ihr Dienstreiseantrag kann nur mit Änderungen freigegeben werden.
Bitte setzen sie sich mit ${user.firstname(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)} ${user.lastname(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)} in Verbindung:
E-Mail: ${user.email(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)} 
Telefon: ${user.phone(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)}


${user.salutation(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)} ${user.lastname(Task_Angaben_korrigieren_Reisesachbearbeitung_complete_user)} hat folgenden Kommentar zum Änderungsbedarf angegeben: ${RueckfrageKommentar}


Diese E-Mail wurde aus der Anwendung Digital WF 2 erstellt. Bitte antworten Sie nicht auf diese E-Mail. Antworten an diese E-Mail-Adresse werden nicht gelesen.


Mit freundlichen Grüßen
Ihre Sachbearbeitung</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_Rueckfrage</bpmn:incoming>
      <bpmn:outgoing>Flow_0zkrdpu</bpmn:outgoing>
    </bpmn:serviceTask>
