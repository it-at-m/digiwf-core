      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hqvfsv</bpmn:incoming>
      <bpmn:outgoing>Flow_01l7jf7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="ServiceTask_Referat_Gestattung_Genehmiger" name="ServiceTask Referat Gestattung Genehmiger" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTask" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailDelegate}">
