          <camunda:inputParameter name="digitalwf_notification_send_assignee">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_task_description">
            <camunda:script scriptFormat="javascript">//TaskTitle setzen
task_title_ui = TaskTitle;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="akrMailPart">Ihr Antrag auf Zustimmung zur Annahme einer Zuwendung nach § 5 AKR wurde ${ZsZustimmung  != 'false' ? 'genehmigt' : 'abgelehnt'}: 
Beförderungsmittel: ${BefoerderungsMittelBezahltDurchDritte}  ${BefoerderungsMittelBezahltDurchDritteWert}
Übernachtungen: ${UebernachtungBezahltDurchDritte}  ${UebernachtungBezahltDurchDritteWert} 
Begründung: ${AkbBegruendung}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1sef5ek</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0hns9mk</bpmn:outgoing>
    </bpmn:userTask>
