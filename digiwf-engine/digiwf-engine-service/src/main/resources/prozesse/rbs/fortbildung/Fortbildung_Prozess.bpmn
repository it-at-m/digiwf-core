    <bpmn:serviceTask id="Activity_19wpiir" name="SK an Entscheidung und Rückmeldung erinnern" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTaskTemplate" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailTemplateDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="TEMPLATE_ID">default</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SENDER" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME" />
          <camunda:inputParameter name="MAILING_RECEIVERS">${user.email(FormField_BearbeiterinSK)}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_REPLY_TO">${processconfig.get("soMail")}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BOTTOM">Viele Grüße
Ihre Seminarorganisation
${processconfig.get("soMail")}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Guten Tag,

bitte teilen Sie uns ihre Entscheidung für das folgende Training mit.
E: ${FormField_IdE}
Titel: ${FormField_Title}

Denken Sie bitte außerdem daran, die Teilnehmer*innen im LSO Monitor entsprechend auszuwählen.</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SUBJECT">Entscheidung / Teilnehmer*innen rückmelden, E ${FormField_IdE}, ${FormField_Title}</camunda:inputParameter>
        </camunda:inputOutput>
