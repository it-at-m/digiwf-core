    <bpmn:startEvent id="StartEvent_Forbildung" name="Mail erhalten" camunda:formKey="Fortbildung_AnfrageErhaltenV01">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">execution.setVariable("task_description", FormField_Title);

process.setDescription(FormField_Title);


var soUsers = processconfig.get("soUsers");

execution.setVariable("soCandidateUsers",soUsers);

var soUserArray = soUsers.split(',');
var instanceId = execution.getProcessInstanceId();

for(var i = 0 ; i &lt; soUserArray.length; i++) {
var user = soUserArray[i];
processInstanceAuthService.createAuthorization(instanceId ,user);
}</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_184dcr6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1t712cw" sourceRef="Gateway_0pjev9j" targetRef="Event_10das3h" />
    <bpmn:userTask id="Task_DKontrollierenAnpassen" name="D kontrollieren / anpassen" camunda:formKey="Fortbildung_DKontrollierenAnpassenV01" camunda:assignee="${starterOfInstance}" camunda:candidateUsers="${soCandidateUsers}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="app_notification_send_candidate_groups">false</camunda:inputParameter>
          <camunda:inputParameter name="app_notification_send_candidate_users">false</camunda:inputParameter>
          <camunda:inputParameter name="app_notification_send_assignee">false</camunda:inputParameter>
          <camunda:inputParameter name="app_task_description">${task_description}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable("app_last_worker", Task_DKontrollierenAnpassen_complete_user)</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable("task_description", FormField_Title+ ' '+ FormField_NameReferent);

process.setDescription(FormField_Title+ ' '+ FormField_NameReferent);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1iwo6ju</bpmn:incoming>
      <bpmn:outgoing>Flow_1s0dzmm</bpmn:outgoing>
    </bpmn:userTask>
