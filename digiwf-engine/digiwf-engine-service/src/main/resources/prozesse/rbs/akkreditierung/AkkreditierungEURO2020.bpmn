<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1hsqiju" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.6.0">
  <bpmn:process id="AkkreditierungJournalistenEM2020" name="Presseakkreditierung für die EURO 2020" isExecutable="true" camunda:versionTag="0.1">
    <bpmn:documentation>Antrag auf Akkreditierung von Journalisten für städtische Veranstaltungen der EURO2020</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_AntragEingegangen" name="Antrag ist eingegangen" camunda:formKey="AkkreditierungEURO2020_Startformular_V01">
      <bpmn:outgoing>Flow_0o8e9hc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0o8e9hc" sourceRef="StartEvent_AntragEingegangen" targetRef="Event_AntragOffen" />
    <bpmn:exclusiveGateway id="Gateway_Verzweigend_EntscheidungAkkreditierung" name="Akkreditierung?">
      <bpmn:incoming>Flow_162lvcf</bpmn:incoming>
      <bpmn:outgoing>Flow_0xum8gw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1webfal</bpmn:outgoing>
      <bpmn:outgoing>Flow_1dyaf63</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0d0anbo" sourceRef="Task_AntragPruefenUndEntscheiden" targetRef="Gateway_Verzweigend_Aenderung" />
    <bpmn:sequenceFlow id="Flow_0xum8gw" name="ja" sourceRef="Gateway_Verzweigend_EntscheidungAkkreditierung" targetRef="Event_Akkreditiert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FormField_Entscheidung == 'Value_Akkreditiert'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AkkreditierungsbestaetigungVersenden" name="Akkreditierungsbestätigung versenden" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTaskTemplate" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailTemplateDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME" />
          <camunda:inputParameter name="MAILING_SUBJECT">UEFA EURO 2020 - Ihre Presseakkreditierung / your press accreditation</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_REPLY_TO">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_RECEIVERS">${mailadresse}</camunda:inputParameter>
          <camunda:inputParameter name="TEMPLATE_ID">euro2020</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SENDER">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BOTTOM">Thank you very much for your application for press accreditation. Your accreditation pressbadge for the UEFA EURO 2020-Events of the Host City Munich will be ready for personal collection at the Volunteer-Center in the Olympic Park during opening hours.

Please bring a valid photo ID with you for collection.


You can pick up your press accreditation badge here: 
Volunteer-Center
Kleine Olympiahalle, Olympiapark München, Spiridon-Louis-Ring 21, 80809 München 

opening hours:
Pre-Tournament (01.06. - 14.06.): 07.30 am – 21.30pm
Matchdays (15.06., 19.06., 23.06., 02.07.): 06.30 am – 01.00 pm
Matchdays+1 (16.06., 20.06., 24.06., 03.07.): 08.00 am – 01.00 pm
Matchdays-1 (14.06., 18.06., 22.06., 01.07.): 07.00 am – 01.00 pm
Non-Matchdays (11.-13.06., 17.06., 21.06., 25.06.-30.06., 04.-11.07.): 10.00 am – 01.00 pm

Best regards,

Your UEFA EURO 2020-Press Office Team 

–---------------------------------------------------
City of Munich
Department of Education and Sports
Media and Communications

Office adress:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Vielen Dank für Ihren Antrag auf Presseakkreditierung. Ihr Presseakkreditierungsausweis für die städtischen Veranstaltungen für die UEFA EURO 2020 in München liegt im Volunteer-Center im Olympiapark zur persönlichen Abholung während der Öffnungszeiten bereit.

Bitte bringen Sie zur Abholung einen gültigen Lichtbildausweis mit.

Hier können Sie Ihren Presseakkreditierungsausweis  abholen: 
Volunteer-Center 
Kleine Olympiahalle, Olympiapark München, Spiridon-Louis-Ring 21, 80809 München 

Öffnungszeiten: 
Vor dem 1. Spieltag (01.06. - 14.06.): 07:30 - 21:30 Uhr 
An Spieltagen (15.06., 19.06., 23.06., 02.07.): 06:30 - 01:00 Uhr 
Spieltage+1 (16.06., 20.06., 24.06., 03.07.): 08:00 - 01:00 Uhr 
Spieltage-1 (14.06., 18.06., 22.06., 01.07.): 07:00 - 01:00 Uhr 
keine Spieltage (11.-13.06., 17.06., 21.06., 25.06.-30.06., 04.-11.07.): 10:00 - 01:00 Uhr 

Mit freundlichen Grüßen


Ihr Team der UEFA EURO 2020-Pressestelle 

–----------------------------------------------------
Landeshauptstadt München
Referat für Bildung und Sport
Presse- und Öffentlichkeitsarbeit

Büroanschrift:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de


_______________________________________________________________</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1dkfs3q</bpmn:incoming>
      <bpmn:outgoing>Flow_1gts1wo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1webfal" name="nein, Informationen unvollständig" sourceRef="Gateway_Verzweigend_EntscheidungAkkreditierung" targetRef="Event_UnterlagenNachgefordert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FormField_Entscheidung == 'Value_UnterlagenVervollstaendigen'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_InformationenNachfordern" name="Informationen nachfordern" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTaskTemplate" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailTemplateDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME" />
          <camunda:inputParameter name="MAILING_SUBJECT">UEFA EURO 2020 - Ihr Antrag auf Presseakkreditierung/your application for press accreditation</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_REPLY_TO">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_RECEIVERS">${mailadresse}</camunda:inputParameter>
          <camunda:inputParameter name="TEMPLATE_ID">euro2020</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SENDER">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Ihren Antrag auf Erteilung einer Presseakkreditierung für die städtischen Veranstaltungen der UEFA EURO 2020 in München haben wir erhalten. Um Ihren Antrag auf Presseakkreditierung erfolgreich abschließen zu können, möchten wir Sie bitten, folgende Unterlagen nachzureichen:

${FormField_FehlendeUnterlagen}

Bei Rückfragen können Sie sich jederzeit gerne an uns wenden:

Tel. +49 (0)89 233-85900
E-Mail: media.euro2020@muenchen.de

Mit freundlichen Grüßen

Ihr Team der UEFA EURO 2020 Pressestelle

–---------------------------------------------------
Landeshauptstadt München
Referat für Bildung und Sport
Presse und Kommunikation

Büroanschrift:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de


_______________________________________________________________</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BOTTOM">We have received your application for a press accreditation for the UEFA EURO 2020-Events of the Host City Munich. In order to successfully complete your application for press accreditation, we would like to ask you to submit the following documents:

${FormField_FehlendeUnterlagen}

Please feel free to contact us at any time if you have any questions:

Phone +49 (0)89 233-85900
E-mail: media.euro2020@muenchen.de

Best regards,

Your UEFA EURO 2020 Press Office Team

–---------------------------------------------------
City of Munich
Department of Education and Sports
Media and Communications

Office adress:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g14bi7</bpmn:incoming>
      <bpmn:outgoing>Flow_04xhyob</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ZusammenfuehrendStartBearbeitung">
      <bpmn:incoming>Flow_12dfe73</bpmn:incoming>
      <bpmn:incoming>Flow_0cgpb7e</bpmn:incoming>
      <bpmn:outgoing>Flow_0losh20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0losh20" sourceRef="Gateway_ZusammenfuehrendStartBearbeitung" targetRef="Task_AntragPruefenUndEntscheiden" />
    <bpmn:sequenceFlow id="Flow_04xhyob" sourceRef="Task_InformationenNachfordern" targetRef="Gateway_Zusammenfuehrend_InformationenNachfordern" />
    <bpmn:boundaryEvent id="Event_1i7ozrj" attachedToRef="Task_AntragPruefenUndEntscheiden">
      <bpmn:outgoing>Flow_0c3ludv</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_08xc5ns">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2025-07-12T23:59:59Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_VorgangBeendet" name="Vorgang beendet">
      <bpmn:incoming>Flow_1n0vu5j</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0c3ludv" sourceRef="Event_1i7ozrj" targetRef="Event_VorgangBeendet" />
    <bpmn:userTask id="Task_AntragPruefenUndEntscheiden" name="Antrag prüfen und entscheiden" camunda:formKey="AkkreditierungEURO2020_AntragPruefenUndEntscheiden_V01" camunda:assignee="${BearbeiterAnfrage}" camunda:candidateGroups="rbs-pk,itm-km8">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_assign_user_to_processinstance">true</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_task_description">
            <camunda:script scriptFormat="Javascript">task_title_ui = execution.getVariable('Antragsteller');
task_title_ui += ', Entscheidung: ';
task_title_ui += execution.getVariable('AktuelleEntscheidung');</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send">false</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("BearbeiterAnfrage", task.getAssignee());</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0losh20</bpmn:incoming>
      <bpmn:outgoing>Flow_0d0anbo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1gts1wo" sourceRef="Task_AkkreditierungsbestaetigungVersenden" targetRef="Gateway_Zusammenfuehrend_AkkreditierungAblehnungAkkreditierung" />
    <bpmn:sequenceFlow id="Flow_1dyaf63" name="nein, abgelehnt" sourceRef="Gateway_Verzweigend_EntscheidungAkkreditierung" targetRef="Event_Abgelehnt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FormField_Entscheidung == 'Value_NichtAkkreditiert'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AblehnungAkkreditierungVersenden" name="Ablehnung der Akkreditierung versenden" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTaskTemplate" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailTemplateDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID" />
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME" />
          <camunda:inputParameter name="MAILING_SUBJECT">UEFA EURO 2020 - Ihr Antrag auf Presseakkreditierung / your application for press accreditation</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_REPLY_TO">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_RECEIVERS">${mailadresse}</camunda:inputParameter>
          <camunda:inputParameter name="TEMPLATE_ID">euro2020</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SENDER">media.euro2020@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Ihren Antrag auf Erteilung einer Presseakkreditierung für die städtischen Veranstaltungen der UEFA EURO 2020 in München haben wir erhalten. Nach der Überprüfung Ihrer Daten müssen wir Ihren Antrag auf Erteilung einer Presseakkreditierung leider ablehnen. Da Sie keine journalistische Legitimation vorgewiesen haben oder ausschließlich privat auf sozialen Netzwerken aktiv sind, erfüllen Sie leider nicht die Voraussetzungen für eine Presseakkreditierung.

Bei Rückfragen können Sie sich jederzeit gerne an uns wenden:

Tel. +49 (0)89 233-85900
E-Mail: media.euro2020@muenchen.de

Mit freundlichen Grüßen

Ihr Team der UEFA EURO 2020 Pressestelle 

–---------------------------------------------------
Landeshauptstadt München
Referat für Bildung und Sport
Presse und Kommunikation

Büroanschrift:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de


_______________________________________________________________</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BOTTOM">We have received your application for an accreditation for the UEFA EURO 2020-Events of the Host City Munich. After checking your data,we have to unfortunately reject your application for press accreditation. As you have not presented any journalistic legitimacy or operate solely on a private basis in social media contexts, you unfortunately do not meet the requirements for press accreditation.

Please feel free to contact us at any time if you have any questions:

Phone +49 (0)89 233-85900
E-mail: media.euro2020@muenchen.de

Best regards,

Your UEFA EURO 2020 Press Office Team

–----------------------------------------------------
City of Munich
Department of Education and Sports
Press and Public Relations

Office adress:
Bayerstraße 28
80335 München
Tel.: +49(0)89/233-85900
E-Mail: media.euro2020@muenchen.de</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00xk7e9</bpmn:incoming>
      <bpmn:outgoing>Flow_09apccp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Zusammenfuehrend_InformationenNachfordern">
      <bpmn:incoming>Flow_04xhyob</bpmn:incoming>
      <bpmn:incoming>Flow_1gcsfui</bpmn:incoming>
      <bpmn:outgoing>Flow_0tl9w4u</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0tl9w4u" sourceRef="Gateway_Zusammenfuehrend_InformationenNachfordern" targetRef="Gateway_174gz7j" />
    <bpmn:sequenceFlow id="Flow_09apccp" sourceRef="Task_AblehnungAkkreditierungVersenden" targetRef="Gateway_Zusammenfuehrend_AkkreditierungAblehnungAkkreditierung" />
    <bpmn:boundaryEvent id="Event_BearbeitungAbbrechen" name="Bearbeitung abbrechen" attachedToRef="Task_AntragPruefenUndEntscheiden">
      <bpmn:outgoing>Flow_0nluvh6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_09f0qif" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Event_AntragOffen" name="Antrag offen" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="Javascript">process.setStatus("Offen");
execution.setVariable("BearbeiterAnfrage", "");
execution.setVariable("FormField_HistorieNachrichten", "");
execution.setVariable("AktuelleEntscheidung", "Offen");
execution.setVariable("FormField_Entscheidung", "");

antragsteller = 'Antragsteller: ';
antragsteller += execution.getVariable('vorname');
antragsteller += ' ';
antragsteller += execution.getVariable('familienname');
antragsteller += ', Firma: ';
antragsteller += execution.getVariable('firma_firmenname');
execution.setVariable("Antragsteller", antragsteller);
process.setDescription(antragsteller);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0o8e9hc</bpmn:incoming>
      <bpmn:outgoing>Flow_12dfe73</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_12dfe73" sourceRef="Event_AntragOffen" targetRef="Gateway_ZusammenfuehrendStartBearbeitung" />
    <bpmn:intermediateThrowEvent id="Event_Abgelehnt" name="Abgelehnt" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${process.setStatus(&#34;Abgelehnt&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1dyaf63</bpmn:incoming>
      <bpmn:outgoing>Flow_00xk7e9</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_00xk7e9" sourceRef="Event_Abgelehnt" targetRef="Task_AblehnungAkkreditierungVersenden" />
    <bpmn:intermediateThrowEvent id="Event_Akkreditiert" name="Akkreditiert" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${process.setStatus(&#34;Akkreditiert&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xum8gw</bpmn:incoming>
      <bpmn:outgoing>Flow_1dkfs3q</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_1dkfs3q" sourceRef="Event_Akkreditiert" targetRef="Task_AkkreditierungsbestaetigungVersenden" />
    <bpmn:intermediateThrowEvent id="Event_VorgangBeendet" name="Vorgang beendet" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${process.setStatus(&#34;VorgangBeendet&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c3ludv</bpmn:incoming>
      <bpmn:outgoing>Flow_1n0vu5j</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_1n0vu5j" sourceRef="Event_VorgangBeendet" targetRef="EndEvent_VorgangBeendet" />
    <bpmn:exclusiveGateway id="Gateway_Zusammenfuehrend_AkkreditierungAblehnungAkkreditierung">
      <bpmn:incoming>Flow_09apccp</bpmn:incoming>
      <bpmn:incoming>Flow_1gts1wo</bpmn:incoming>
      <bpmn:outgoing>Flow_1gcsfui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1gcsfui" sourceRef="Gateway_Zusammenfuehrend_AkkreditierungAblehnungAkkreditierung" targetRef="Gateway_Zusammenfuehrend_InformationenNachfordern" />
    <bpmn:sequenceFlow id="Flow_1ud3pt1" sourceRef="Task_HistorieAktualisieren" targetRef="Gateway_Zusammenfuehrend_AlleErgebnisse" />
    <bpmn:scriptTask id="Task_HistorieAktualisieren" name="Historie aktualisieren" scriptFormat="Javascript">
      <bpmn:incoming>Flow_0lmnmw6</bpmn:incoming>
      <bpmn:outgoing>Flow_1ud3pt1</bpmn:outgoing>
      <bpmn:script>var date_now = new Date();
var month = '' + (date_now.getMonth() + 1);
var day = '' + date_now.getDate();
var year = 1900 + date_now.getYear();
        
if (month.length &lt; 2) 
   month = '0' + month;
if (day.length &lt; 2) 
   day = '0' + day;

var Datum = [day, month, year].join('.');

var entscheidung = execution.getVariable('FormField_Entscheidung');
var text = execution.getVariable('FormField_HistorieNachrichten');
if (!text) text = Datum + ': '; else text += Datum + ': ';
if (entscheidung == 'Value_UnterlagenVervollstaendigen') text += 'Unterlagen vervollständigen';
if (entscheidung == 'Value_NichtAkkreditiert') text += 'Akkreditierung abgelehnt';
if (entscheidung == 'Value_Akkreditiert') {
text += 'Akkreditierung bestätigt';
execution.setVariable('DatumAkkreditierung', Datum);
}
if (entscheidung == 'Value_Offen') text += 'Akkreditierung offen';
text += '\n';
execution.setVariable('FormField_HistorieNachrichten', text);
execution.setVariable('FormField_Entscheidung', '');
execution.setVariable('AktuelleEntscheidung', execution.getVariable('FormField_Entscheidung__detail_name'));
execution.setVariable('FormField_FehlendeUnterlagen', '');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Verzweigend_Aenderung" name="Keine Änderung Entscheidung oder Entscheidung offen?" default="Flow_162lvcf">
      <bpmn:incoming>Flow_0d0anbo</bpmn:incoming>
      <bpmn:outgoing>Flow_162lvcf</bpmn:outgoing>
      <bpmn:outgoing>Flow_07ry0fy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_162lvcf" name="nein" sourceRef="Gateway_Verzweigend_Aenderung" targetRef="Gateway_Verzweigend_EntscheidungAkkreditierung" />
    <bpmn:sequenceFlow id="Flow_07ry0fy" name="ja" sourceRef="Gateway_Verzweigend_Aenderung" targetRef="Gateway_174gz7j">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FormField_Entscheidung == 'Value_Offen'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_174gz7j">
      <bpmn:incoming>Flow_0tl9w4u</bpmn:incoming>
      <bpmn:incoming>Flow_07ry0fy</bpmn:incoming>
      <bpmn:outgoing>Flow_0lmnmw6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0lmnmw6" sourceRef="Gateway_174gz7j" targetRef="Task_HistorieAktualisieren" />
    <bpmn:exclusiveGateway id="Gateway_Zusammenfuehrend_AlleErgebnisse">
      <bpmn:incoming>Flow_1ud3pt1</bpmn:incoming>
      <bpmn:incoming>Flow_0nluvh6</bpmn:incoming>
      <bpmn:outgoing>Flow_0cgpb7e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
