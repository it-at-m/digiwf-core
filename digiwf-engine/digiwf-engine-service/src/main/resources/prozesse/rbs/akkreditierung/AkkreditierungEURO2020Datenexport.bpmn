<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1u9ridu" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.6.0">
  <bpmn:process id="AkkreditierungEURO2020Datenexport" name="Presseakkreditierung für die EURO 2020 - Datenexport" isExecutable="true" camunda:versionTag="0.1">
    <bpmn:documentation>Export der Datenquelle für den Druck der Akkreditierungsausweise</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ExportNotwendig" name="Export notwendig" camunda:asyncBefore="true" camunda:formKey="AkkreditierungEURO2020Datenexport_Startformular_V01">
      <bpmn:outgoing>Flow_1ocgztz</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1ocgztz" sourceRef="StartEvent_ExportNotwendig" targetRef="Task_DatenExportieren" />
    <bpmn:sequenceFlow id="Flow_1cw1mvy" sourceRef="Task_DatenExportieren" targetRef="Task_DatenHerunterladen" />
    <bpmn:endEvent id="Event_ExportBeendet" name="Export beendet">
      <bpmn:incoming>Flow_13lq11z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13lq11z" sourceRef="Task_DatenHerunterladen" targetRef="Event_ExportBeendet" />
    <bpmn:serviceTask id="Task_DatenExportieren" name="Daten exportieren" camunda:modelerTemplate="de.muenchen.digitalisierung.templates.process.InstanzExport" camunda:delegateExpression="${instanceExportDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_process_key">AkkreditierungJournalistenEM2020</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_status_key">Akkreditiert</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_variables">vorname;familienname;firma_firmenname;DatumAkkreditierung</camunda:inputParameter>
          <camunda:outputParameter name="FormField_InstanzExport">${digitalwf_instance_export}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ocgztz</bpmn:incoming>
      <bpmn:outgoing>Flow_1cw1mvy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DatenHerunterladen" name="Daten herunterladen" camunda:formKey="AkkreditierungEURO2020Datenexport_Download_V01" camunda:assignee="${starterOfInstance}" camunda:candidateUsers="${starterOfInstance}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_task_description">Download der Daten für den Druck der Presseausweise</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1cw1mvy</bpmn:incoming>
      <bpmn:outgoing>Flow_13lq11z</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AkkreditierungEURO2020Datenexport">
      <bpmndi:BPMNEdge id="Flow_13lq11z_di" bpmnElement="Flow_13lq11z">
        <di:waypoint x="530" y="117" />
        <di:waypoint x="592" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1cw1mvy_di" bpmnElement="Flow_1cw1mvy">
        <di:waypoint x="370" y="117" />
        <di:waypoint x="430" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1ocgztz_di" bpmnElement="Flow_1ocgztz">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="270" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_ExportNotwendig">
        <dc:Bounds x="179" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156" y="142" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0pdzq9h_di" bpmnElement="Event_ExportBeendet">
        <dc:Bounds x="592" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="572" y="142" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00jpzd8_di" bpmnElement="Task_DatenExportieren">
        <dc:Bounds x="270" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_01uj783_di" bpmnElement="Task_DatenHerunterladen">
        <dc:Bounds x="430" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
