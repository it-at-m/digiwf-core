    <bpmn:callActivity id="Activity_05sxqq7" name="Create Cosys dokument" camunda:modelerTemplate="de.muenchen.digitalwf.templates.GenerateDocumentV02" camunda:modelerTemplateVersion="2" calledElement="StreamingTemplateV02">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="cosysIntegration" target="app_integration_name" />
        <camunda:in sourceExpression="createCosysDocumentV2" target="app_type_name" />
        <camunda:in sourceExpression="${app_file_context}" target="fileContext" />
        <camunda:in sourceExpression="9001" target="client" />
        <camunda:in sourceExpression="TESTER" target="role" />
        <camunda:in sourceExpression="519650b7-87c2-41a6-8527-7b095675b13f" target="guid" />
        <camunda:in sourceExpression="${cosysData}" target="variables" />
        <camunda:in sourceExpression="test/example-cosys-document.pdf" target="filePath" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_193g2tf</bpmn:incoming>
      <bpmn:outgoing>Flow_1478xit</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Activity_0xjgh5j" name="Send Mail" camunda:modelerTemplate="de.muenchen.digitalwf.templates.send-mail-V02" camunda:modelerTemplateVersion="2" calledElement="StreamingTemplateV02">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="emailIntegration" target="app_integration_name" />
        <camunda:in sourceExpression="sendTextMailV2" target="app_type_name" />
        <camunda:in sourceExpression="${app_file_context}" target="fileContext" />
        <camunda:in sourceExpression="${FormField_Email}" target="receivers" />
        <camunda:in sourceExpression="${receiversCc}" target="receiversCc" />
        <camunda:in sourceExpression="${receiversBcc}" target="receiversBcc" />
        <camunda:in sourceExpression="${body}" target="body" />
        <camunda:in sourceExpression="${replyTo}" target="replyTo" />
        <camunda:in sourceExpression="${filePaths}" target="filePaths" />
        <camunda:in sourceExpression="Feature S3 Integration" target="subject" />
        <camunda:out source="mailSentStatus" target="mailSentStatus" />
        <camunda:inputOutput>
          <camunda:inputParameter name="receiversCc" />
          <camunda:inputParameter name="receiversBcc" />
          <camunda:inputParameter name="replyTo" />
          <camunda:inputParameter name="body">Test</camunda:inputParameter>
          <camunda:inputParameter name="filePaths">test/</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1478xit</bpmn:incoming>
      <bpmn:outgoing>Flow_19vunee</bpmn:outgoing>
    </bpmn:callActivity>
