  <bpmn:collaboration id="Collaboration_0e6ak52">
    <bpmn:extensionElements />
    <bpmn:participant id="Participant_1nz00x0" name="User Task process" processRef="Usertask-Example" />
  </bpmn:collaboration>
  <bpmn:process id="Usertask-Example" name="Example Usertask" isExecutable="true">
    <bpmn:startEvent id="Start_Form" name="Start" camunda:formKey="start-form-usertask">
      <bpmn:outgoing>Flow_1fbmdks</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_UserTask" name="User Task" camunda:assignee="${FORMFIELD_User}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="app_task_schema_key">user-task</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fbmdks</bpmn:incoming>
      <bpmn:outgoing>Flow_091qwfe</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopCardinality>${FORMFIELD_NumberOfTasks}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_17q2n00" name="End">
      <bpmn:incoming>Flow_091qwfe</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_000hd7z" triggeredByEvent="true">
      <bpmn:startEvent id="Event_1v0winq" name="Terminates process after 1 hour">
        <bpmn:outgoing>Flow_1tpc9wl</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_1hzdam7">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0dekx0j" name="End Event">
        <bpmn:incoming>Flow_1tpc9wl</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1tpc9wl" sourceRef="Event_1v0winq" targetRef="Event_0dekx0j" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1fbmdks" sourceRef="Start_Form" targetRef="Task_UserTask" />
    <bpmn:sequenceFlow id="Flow_091qwfe" sourceRef="Task_UserTask" targetRef="Event_17q2n00" />
  </bpmn:process>
