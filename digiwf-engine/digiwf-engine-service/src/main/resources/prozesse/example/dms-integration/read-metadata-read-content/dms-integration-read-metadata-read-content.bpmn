  <bpmn:process id="Process_185ibpi" name="Test Schriftstücke laden" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" camunda:formKey="dms-integration-read-metadata-read-content_start">
      <bpmn:outgoing>Flow_0vsdv2i</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_15ha4g9" name="Test DMS Eingaben Merge">
      <bpmn:incoming>Flow_0vsdv2i</bpmn:incoming>
      <bpmn:outgoing>Flow_1kg49fj</bpmn:outgoing>
      <bpmn:script>const coos_1 = JSON.parse(execution.getVariable('coos_1'));
const coos_2 = JSON.parse(execution.getVariable('coos_2'));

const coosCon = coos_1.concat(coos_2);
const coosConString = JSON.stringify(coosCon);

execution.setVariable('contentCoos', coosConString);
const contentCoos = execution.getVariable('contentCoos');

console.log(coos_1);
console.log(coos_2);
console.log(coosCon);
console.log(coosConString);
console.log(contentCoos);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_1fai4r6">
      <bpmn:incoming>Flow_1kg49fj</bpmn:incoming>
    </bpmn:endEvent>
