<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1c78oxa" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.6.0">
  <bpmn:process id="TestFormserverIntegrationWithPerson" name="Example Formserver Integration With Person" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" camunda:formKey="formserver_example_with_person">
      <bpmn:outgoing>Flow_0tqtlp2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1c7xcjc">
      <bpmn:incoming>Flow_08bpold</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0tqtlp2" sourceRef="StartEvent_1" targetRef="Gateway_0ffk8fx" />
    <bpmn:sequenceFlow id="Flow_15zl987" sourceRef="Activity_0ojk6tw" targetRef="Gateway_03saqv2" />
    <bpmn:userTask id="Activity_0ojk6tw" name="Check Vars" camunda:candidateGroups="group1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="app_file_paths">files</camunda:inputParameter>
          <camunda:inputParameter name="app_task_schema_key">formserver_example_with_person</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e9isco</bpmn:incoming>
      <bpmn:outgoing>Flow_15zl987</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0e9isco" sourceRef="Gateway_0ffk8fx" targetRef="Activity_0ojk6tw" />
    <bpmn:parallelGateway id="Gateway_0ffk8fx">
      <bpmn:incoming>Flow_0tqtlp2</bpmn:incoming>
      <bpmn:outgoing>Flow_0e9isco</bpmn:outgoing>
      <bpmn:outgoing>Flow_16iu31k</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_08bpold" sourceRef="Gateway_03saqv2" targetRef="Event_1c7xcjc" />
    <bpmn:parallelGateway id="Gateway_03saqv2">
      <bpmn:incoming>Flow_15zl987</bpmn:incoming>
      <bpmn:incoming>Flow_12nmrsp</bpmn:incoming>
      <bpmn:outgoing>Flow_08bpold</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_16iu31k" sourceRef="Gateway_0ffk8fx" targetRef="Activity_1m1u1pp" />
    <bpmn:callActivity id="Activity_0src9b9" name="Load Files" camunda:modelerTemplate="de.muenchen.digitalwf.templates.S3CreatePresignedUrlTemplateV01" calledElement="StreamingTemplateV01">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="${app_file_s3_async_config}" target="app_topic_name" />
        <camunda:in sourceExpression="createPresignedUrl" target="app_message_name" />
        <camunda:in sourceExpression="createPresignedUrl" target="app_type_name" />
        <camunda:in sourceExpression="GET" target="action" />
        <camunda:out source="presignedUrls" target="presignedUrls" />
        <camunda:in sourceExpression="${file_paths_readonly}" target="path" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1e0dggb</bpmn:incoming>
      <bpmn:outgoing>Flow_0id6ydq</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0id6ydq" sourceRef="Activity_0src9b9" targetRef="Activity_1ep6cfq" />
    <bpmn:callActivity id="Activity_1ep6cfq" name="Send Mail" camunda:modelerTemplate="de.muenchen.digitalwf.templates.send-email" calledElement="StreamingTemplateV01">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="genericEvent" target="app_message_name" />
        <camunda:in sourceExpression="sendMailFromEventBus" target="app_type_name" />
        <camunda:out source="mailSentStatus" target="mailSentStatus" />
        <camunda:in sourceExpression="${presignedUrls}" target="attachments" />
        <camunda:in sourceExpression="Test" target="body" />
        <camunda:in sourceExpression="TestFormserverIntegrationWithPerson" target="subject" />
        <camunda:in sourceExpression="dwf-email-local-01" target="app_topic_name" />
        <camunda:in sourceExpression="ext.dl.moesle@muenchen.de" target="receivers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0id6ydq</bpmn:incoming>
      <bpmn:outgoing>Flow_12nmrsp</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_12nmrsp" sourceRef="Activity_1ep6cfq" targetRef="Gateway_03saqv2" />
    <bpmn:sequenceFlow id="Flow_1e0dggb" sourceRef="Activity_1m1u1pp" targetRef="Activity_0src9b9" />
    <bpmn:scriptTask id="Activity_1m1u1pp" name="Set File Paths" scriptFormat="javascript">
      <bpmn:incoming>Flow_16iu31k</bpmn:incoming>
      <bpmn:outgoing>Flow_1e0dggb</bpmn:outgoing>
      <bpmn:script>const app_file_paths = "file_paths";
const app_file_paths_readonly = "file_paths_readonly";

const person = JSON.parse(execution.getVariable("Person"));
let filePaths = "";
let filePathsReadonly = "";

for (let i = 0; i &lt; person.length; i++) {
    filePaths += "files/" + person[i].files.key + ";";
    filePathsReadonly += "files/" + person[i].files.key + ";";
}

// remove last ,
filePaths = filePaths.substring(0, filePaths.length - 1);
filePathsReadonly = filePathsReadonly.substring(0, filePathsReadonly.length - 1);

execution.setVariable(app_file_paths, filePaths);
execution.setVariable(app_file_paths_readonly, filePathsReadonly);
</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
