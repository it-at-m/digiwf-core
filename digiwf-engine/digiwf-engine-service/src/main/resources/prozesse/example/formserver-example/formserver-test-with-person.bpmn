        <di:waypoint x="168" y="117" />
        <di:waypoint x="205" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1e0dggb_di" bpmnElement="Flow_1e0dggb">
        <di:waypoint x="370" y="230" />
        <di:waypoint x="440" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Activity_0owxmc1_di" bpmnElement="Activity_0src9b9">
        <dc:Bounds x="440" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1t57kw2_di" bpmnElement="Activity_1ep6cfq">
        <dc:Bounds x="620" y="190" width="100" height="80" />
