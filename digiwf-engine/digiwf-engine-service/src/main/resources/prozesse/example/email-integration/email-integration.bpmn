  <bpmn:process id="email-integration-example" name="Example Email Integration" isExecutable="true">
    <bpmn:documentation />
    <bpmn:extensionElements />
    <bpmn:startEvent id="StartEvent_1" name="Create Email" camunda:formKey="email-integration_start">
      <bpmn:outgoing>Flow_1gti212</bpmn:outgoing>
