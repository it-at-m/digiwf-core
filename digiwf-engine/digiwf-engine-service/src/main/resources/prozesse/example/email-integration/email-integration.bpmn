    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1gti212" sourceRef="StartEvent_1" targetRef="Gateway_1o6jzx7" />
    <bpmn:sequenceFlow id="Flow_0t4oshz" sourceRef="Gateway_1o6jzx7" targetRef="send-mail" />
    <bpmn:sequenceFlow id="Flow_0txn7ai" sourceRef="Activity_0fb3dp9" targetRef="Gateway_1o6jzx7" />
    <bpmn:userTask id="Activity_0fb3dp9" name="Create Email" camunda:assignee="0000000">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="app_task_schema_key">email-integration_start</camunda:inputParameter>
        </camunda:inputOutput>
