    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0ywe8vx" sourceRef="Event_1w3io29" targetRef="Activity_0fb3dp9" />
    <bpmn:parallelGateway id="Gateway_1o6jzx7">
