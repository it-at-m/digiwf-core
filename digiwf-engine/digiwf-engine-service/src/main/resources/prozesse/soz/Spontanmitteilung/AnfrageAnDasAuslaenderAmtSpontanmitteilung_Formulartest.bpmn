          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("FormField_Sachbearbeitung", task.getAssignee());</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pgaamu</bpmn:incoming>
      <bpmn:outgoing>Flow_0c2qf2h</bpmn:outgoing>
    </bpmn:userTask>
