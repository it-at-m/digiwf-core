    <bpmn:userTask id="UserTask_0po31mt" name="Anfrage beantworten" camunda:asyncBefore="true" camunda:formKey="AnfrageAnDasAuslaenderAmtSpontanmitteilung_AnfrageBeantworten_V1" camunda:assignee="${starterOfInstance}" camunda:candidateUsers="${starterOfInstance}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">if (execution.getVariable('Eingang_SOZ') == null) {
  var date_now = new Date();
  var month = '' + (date_now.getMonth() + 1);
  var day = '' + date_now.getDate();
  var year = 1900 + date_now.getYear();
        
  if (month.length &lt; 2) 
    month = '0' + month;
  if (day.length &lt; 2) 
    day = '0' + day;

  execution.setVariable('Eingang_SOZ', [day, month, year].join('.'));
}</camunda:script>
        </camunda:executionListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_button_cancelable">true</camunda:inputParameter>
          <camunda:inputParameter name="task_title_ui">
            <camunda:script scriptFormat="Javascript">task_title_ui = execution.getVariable("_kvrUserTaskTitle");</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("_kvrSachbearbeitung", task.getAssignee());</camunda:script>
        </camunda:taskListener>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="Javascript">var fehlerhafteSchriftstuecke = task.execution.getVariable("_fehlerhafteSchriftstuecke");

if ((fehlerhafteSchriftstuecke) &amp;&amp; (fehlerhafteSchriftstuecke != "")) {
   task.execution.setVariable("_fehlerhafteSchriftstuecke", "*** Folgende Schriftstücke konnten nicht kopiert werden: " + fehlerhafteSchriftstuecke + ". Bitte überprüfen Sie die Ursache und versuchen Sie es erneut. Wenn Sie keinen Zugriff auf diese Dokumente haben, entfernen Sie diese bitte. ***");
}</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_0t00o8j</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_083892b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_0t00o8j" sourceRef="Gateway_11y2g5n" targetRef="UserTask_0po31mt" />
    <bpmn:startEvent id="StartEvent_0pk8uqk" name="§2-Abfrage nötig" camunda:asyncBefore="true" camunda:formKey="AnfrageAnDasAuslaenderAmtSpontanmitteilung_Startformular_V1">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable('FormField_Begruendung_Plausibilitaet', '');
execution.setVariable('FormField_Ruecklauf_Kommentar', '');
execution.setVariable('kvr_group_validation', '');

/**
if (FormField_Geburtsdatum){
    var month = '' + (FormField_Geburtsdatum.getMonth() + 1);
    var day = '' + FormField_Geburtsdatum.getDate();
    var year = 1900 + FormField_Geburtsdatum.getYear();
        
    if (month.length &lt; 2) 
        month = '0' + month;
    if (day.length &lt; 2) 
        day = '0' + day;

    //execution.setVariable('GeburtstagAsString', [day, month, year].join('/'));
    execution.setVariable('GeburtstagMitPunktenAsString', [day, month, year].join('.'));
} else {
     execution.setVariable('GeburtstagMitPunktenAsString', null); 
}

var dmsVorgangTitel = '§1a-Anfrage / ' + FormField_Name + ', ' + FormField_Vorname;
if (execution.hasVariable("GeburtstagMitPunktenAsString") &amp;&amp; GeburtstagMitPunktenAsString != null ) {
	dmsVorgangTitel += ' / ' + GeburtstagMitPunktenAsString;
}
if (execution.hasVariable("FormField_LISSA_Aktivitaet_ID") &amp;&amp; FormField_LISSA_Aktivitaet_ID != null ) {
	dmsVorgangTitel += ' / ' + FormField_LISSA_Aktivitaet_ID;
}
execution.setVariable('_dmsVorgangTitel', dmsVorgangTitel);
*/</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>SequenceFlow_1felg40</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1felg40" sourceRef="StartEvent_0pk8uqk" targetRef="Gateway_11y2g5n" />
    <bpmn:userTask id="UserTask_0nx1wel" name="Angaben prüfen" camunda:asyncBefore="true" camunda:formKey="AnfrageAnDasAuslaenderAmt2_AngabenPruefen_V1" camunda:assignee="${starterOfInstance}" camunda:candidateUsers="${starterOfInstance}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="task_title_ui">
            <camunda:script scriptFormat="Javascript">//TaskTitle formatieren
task_title_ui = execution.getVariable("_kvrUserTaskTitle");</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("_kvrSachbearbeitung", task.getAssignee());
if (task.execution.getVariable("_test_kvrDmsUserLogin") &amp;&amp; (task.execution.getVariable("_test_kvrDmsUserLogin") != "")) {
	task.execution.setVariable("_kvrDmsUserLogin", task.execution.getVariable("_test_kvrDmsUserLogin"));
} else task.execution.setVariable("_kvrDmsUserLogin", task.getAssignee());</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_083892b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0i2p5uk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_083892b" sourceRef="UserTask_0po31mt" targetRef="UserTask_0nx1wel" />
    <bpmn:sequenceFlow id="SequenceFlow_0i2p5uk" sourceRef="UserTask_0nx1wel" targetRef="Gateway_0dby2h3" />
    <bpmn:textAnnotation id="TextAnnotation_0bp3y4a">
      <bpmn:text>Antwort des FB auf meine Frage: ...Seite 1: Ja, der Einstieg ist wie bei einer §1a- Anfrage. Die Anfragen zu Erstanfrage und Titel müssen sein, da wir ja gerade beim §2 AsylbLG den Verlauf des Leistungsbezuges überprüfen müssen, dafür auch zwei Dokumente in LISSA haben (1.Anfrage und Folgeanfrage zB wenn ein Statuswechsel erfolgt). Wechsel Seite 2: Dass die Einzelpunkte nicht "verschachtelt" formuliert sind ist in Ordnung. Sind sie in unserem aktuellen Dokument übrigens auch nicht!....</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17nktpx" sourceRef="StartEvent_0pk8uqk" targetRef="TextAnnotation_0bp3y4a" />
    <bpmn:textAnnotation id="TextAnnotation_1nawn4q">
      <bpmn:text>Hinweis von Petra: ...Auch denke ich, dass die Angabe des Status/Titels vom KVR kommen soll, wir diese Auflistung nicht brauchen, sondern der MA des KVR diesen mitteilen soll. So haben wir auch immer die aktuellste Info vom KVR...</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17nej7j" sourceRef="StartEvent_0pk8uqk" targetRef="TextAnnotation_1nawn4q" />
  </bpmn:process>
