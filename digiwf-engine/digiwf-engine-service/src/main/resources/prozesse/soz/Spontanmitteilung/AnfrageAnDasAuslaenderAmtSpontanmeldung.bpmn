    <bpmn:serviceTask id="Task_KVRUeberRueckfrageBenachrichtigen" name="KVR über Rückfrage benachrichtigen" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTask" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailDelegate}">
