    <bpmn:serviceTask id="Task_InformationZuWorkflowstartAnSachbearbeitungSenden" name="Information zu Workflowstart an Sachbearbeitung senden" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTask" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="MAILING_REPLY_TO">itm.digitalwf@muenchen.de</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_RECEIVERS">${user.email(FormField_Sachbearbeitung)}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_SUBJECT">Neues zu Ihrer Spontanmeldung: ${FormField_LISSA_Aktenzeichen}, ${FormField_Vorname} ${FormField_Name}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_BODY">Hallo,


Ihre Anfrage zu o.g. Fall wurde an das Kreisverwaltungsreferat zur Beantwortung übermittelt. Zu Ihrer Information finden Sie anbei die von Ihnen erfassten Daten zur Anfrage.


Viele Grüße
Ihr Digital WF-Team</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_ATTACHMENT_GUID">${_protokollDokumentCosysGUID}</camunda:inputParameter>
          <camunda:inputParameter name="MAILING_ATTACHMENT_NAME">${_protokollDateiName}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d2o109</bpmn:incoming>
      <bpmn:outgoing>Flow_1fc5fyz</bpmn:outgoing>
