      <bpmn:incoming>SequenceFlow_automatische_Zuweisung</bpmn:incoming>
      <bpmn:outgoing>Flow_1725cpn</bpmn:outgoing>
      <bpmn:script>execution.setVariable("FormField_ZustaendigkeitKVRII3", "Value_Ja");
tmpGroup = execution.getVariable("kvrResponsibleGroup");
tmpGroup = tmpGroup.replace(" ", "");
tmpGroup = tmpGroup.replace("-", "");
tmpGroup = tmpGroup.replace("/", "");
execution.setVariable("FormField_Zustaendigkeit", tmpGroup);</bpmn:script>
