    <bpmn:serviceTask id="Task_AktuellesAktendokumentAnKVRVersenden" name="Aktuelles Aktendokument an KVR versenden" camunda:modelerTemplate="de.muenchen.digitalwf.templates.MailTask" camunda:asyncBefore="true" camunda:delegateExpression="${sendMailDelegate}">
