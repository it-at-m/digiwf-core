        <camunda:in sourceExpression="${_sDmsTopLevelKnoten}" target="dms_aktenplan_name" />
        <camunda:out source="dms_vorgang_coo" target="_dmsVorgangCOO" />
        <camunda:in sourceExpression="${_sDmsKuemmerer}" target="dms_fehlerhandling_user" />
        <camunda:out source="dms_created_schriftstueck" target="_dmsSchriftstueckCOO" />
        <camunda:in sourceExpression="${_protokollDokumentCosysGUID}" target="dms_cosys_guid" />
        <camunda:in sourceExpression="${_sDmsAktenplanUntergruppe}" target="dms_untergruppe" />
      </bpmn:extensionElements>
