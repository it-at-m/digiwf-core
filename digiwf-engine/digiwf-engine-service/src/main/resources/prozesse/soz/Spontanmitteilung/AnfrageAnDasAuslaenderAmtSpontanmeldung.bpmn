    <bpmn:sequenceFlow id="Flow_0xna62i" name="Ja" sourceRef="Gateway_Verzweigend_DokumentStornieren" targetRef="Task_DokumentStornieren" />
    <bpmn:sequenceFlow id="Flow_0mtlfck" sourceRef="Task_DokumentStornieren" targetRef="Gateway_Zusammenfuehrend_DokumentStornieren" />
    <bpmn:sequenceFlow id="Flow_0337ucr" sourceRef="Gateway_Zusammenfuehrend_DokumentStornieren" targetRef="Task_SchriftstueckeKopieren" />
    <bpmn:sequenceFlow id="Flow_03133k2" name="Nein" sourceRef="Gateway_Verzweigend_DokumentStornieren" targetRef="Gateway_Zusammenfuehrend_DokumentStornieren">
