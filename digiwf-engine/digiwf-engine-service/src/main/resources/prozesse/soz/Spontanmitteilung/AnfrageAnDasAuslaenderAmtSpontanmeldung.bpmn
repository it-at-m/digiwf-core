    <bpmn:serviceTask id="Task_AnfrageDerZustaendigenGruppeZuweisen" name="Anfrage der zuständigen Gruppe zuweisen" camunda:modelerTemplate="de.muenchen.digitalisierung.templates.kvr.AlwPersoneninfo" camunda:asyncBefore="true" camunda:delegateExpression="${kvrPersonenInfoDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="kvr_azr_nummer">${FormField_AZR_Nummer}</camunda:inputParameter>
          <camunda:outputParameter name="kvrResponsibleGroup">${kvr_responsible_group}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="Javascript">var date_now = new Date();
var month = '' + (date_now.getMonth() + 1);
var day = '' + date_now.getDate();
var year = 1900 + date_now.getYear();
        
if (month.length &lt; 2) 
   month = '0' + month;
if (day.length &lt; 2) 
   day = '0' + day;

execution.setVariable('Eingang_KVR', [day, month, year].join('.'));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1iwg7xx</bpmn:incoming>
      <bpmn:outgoing>Flow_0v3ihdl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Task_StatusdokumentInDerAkteAnlegen" name="Statusdokument in der Akte anlegen" camunda:modelerTemplate="de.muenchen.digitalisierung.templates.dms.VorgangAnlegenTemplate" calledElement="VorgangAnlegenV01">
