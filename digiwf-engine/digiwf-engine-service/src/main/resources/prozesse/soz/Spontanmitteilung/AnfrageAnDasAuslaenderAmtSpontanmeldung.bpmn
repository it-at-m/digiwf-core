    <bpmn:scriptTask id="Task_ProzessvariablenSetzen" name="Prozessvariablen setzen" camunda:asyncBefore="true" scriptFormat="Javascript">
      <bpmn:incoming>Flow_0fm4c75</bpmn:incoming>
      <bpmn:outgoing>Flow_1a8tx5h</bpmn:outgoing>
      <bpmn:script>//******************************************************************

execution.setVariable("kvrResponsibleGroup", null);

//******************************************************************
//Variablen initialisieren
execution.setVariable('FormField_Begruendung_Plausibilitaet', '');
execution.setVariable('FormField_Ruecklauf_Kommentar', '');
execution.setVariable('kvr_group_validation', '');

//******************************************************************
//BusinessKey vorbereiten
if (!execution.getVariable('FormField_LISSA_Aktivitaet_ID')) execution.setVariable('FormField_LISSA_Aktivitaet_ID', "(unbekannt)");
var LISSA_Aktivitaet_ID = execution.getVariable('FormField_LISSA_Aktivitaet_ID');
var LISSA_Aktenzeichen = execution.getVariable('FormField_LISSA_Aktenzeichen');
execution.setVariable("_LISSA_Aktivitaet_ID", LISSA_Aktivitaet_ID);
execution.setVariable("_LISSA_Aktenzeichen", LISSA_Aktenzeichen);

//******************************************************************
//Sachbearbeitung auf Prozessstarter setzen
if (!FormField_Sachbearbeitung) {
 execution.setVariable("FormField_Sachbearbeitung", execution.getVariable("starterOfInstance"));
}

//******************************************************************
//Geburtsdatum formatieren
/**
if (FormField_Geburtsdatum){
    var month = '' + (FormField_Geburtsdatum.getMonth() + 1);
    var day = '' + FormField_Geburtsdatum.getDate();
    var year = 1900 + FormField_Geburtsdatum.getYear();
        
    if (month.length &lt; 2) 
        month = '0' + month;
    if (day.length &lt; 2) 
        day = '0' + day;

    //execution.setVariable('GeburtstagAsString', [day, month, year].join('/'));
    execution.setVariable('GeburtstagMitPunktenAsString', [day, month, year].join('.'));
} else {
     execution.setVariable('GeburtstagMitPunktenAsString', null); 
}*/

//*****************************************************************
//Titel für Vorgang im DMS und für KVR-Mailbenachrichtigungen ermitteln
var dmsVorgangTitel = 'Spontanmeldung / ' + FormField_Name.toUpperCase() + ', ' + FormField_Vorname;
if (execution.hasVariable("FormField_Geburtsdatum") &amp;&amp; FormField_Geburtsdatum != null ) {
	dmsVorgangTitel += ' / ' + FormField_Geburtsdatum__detail_format;
}
if (execution.hasVariable("FormField_LISSA_Aktivitaet_ID") &amp;&amp; FormField_LISSA_Aktivitaet_ID != null ) {
	dmsVorgangTitel += ' / ' + FormField_LISSA_Aktivitaet_ID;
}
execution.setVariable('_dmsVorgangTitel', dmsVorgangTitel);

var processDesc = FormField_Name.toUpperCase() + ', ' + FormField_Vorname;
if (execution.hasVariable("FormField_Geburtsdatum") &amp;&amp; FormField_Geburtsdatum != null ) {
	processDesc += ' / ' + FormField_Geburtsdatum__detail_format;
}
if (execution.hasVariable("FormField_AZR_Nummer") &amp;&amp; FormField_AZR_Nummer != null ) {
	processDesc += ' / ' + FormField_AZR_Nummer;
}
execution.setVariable('_kvrBenachrichtigungenBetreff', ' / ' + processDesc);
process.setDescription(processDesc);

//*****************************************************************
//Titel für die Tasks setzen
//TaskTitle formatieren
var taskTitle = FormField_LISSA_Aktenzeichen + ", " + FormField_Name.toUpperCase() + ", " + FormField_Vorname;
if (FormField_Geburtsdatum) taskTitle = taskTitle + ", geboren am " + FormField_Geburtsdatum__detail_format;
execution.setVariable("_sozUserTaskTitle", taskTitle);

//TaskTitle für KVR bauen
var taskTitleKvr;
if (FormField_AZR_Nummer) {
	taskTitleKvr = FormField_AZR_Nummer + ", " + FormField_Name.toUpperCase() + ", " + FormField_Vorname;
} else {
	taskTitleKvr = FormField_Name.toUpperCase() + ", " + FormField_Vorname;	
}
if (FormField_Antwort_bis) taskTitleKvr = taskTitleKvr + ", Antwort bis: " + FormField_Antwort_bis__detail_format;
execution.setVariable("_kvrUserTaskTitle", taskTitleKvr);

//*****************************************************************
//Name des Protokolldokuments setzen
execution.setVariable("_protokollName", "Protokoll");
//Name des Anlagendokuments setzen
execution.setVariable("_anlagenDokumentName", "Anlagen");


//*****************************************************************
//Variablen für DMS setzen
execution.setVariable("_sDmsUserLogin", execution.getVariable("FormField_Sachbearbeitung"));
execution.setVariable("_sDmsProtokollDokumentName", "Protokoll");
execution.setVariable("_sDmsFehlerbehandlungEmail", "mfa.dms.soz@muenchen.de");
execution.setVariable("_sDmsTopLevelKnoten", "4164.999/S-III-MF/A/WH/DigitalWF-Ablage");
execution.setVariable("_sDmsAktenplanUntergruppe", "4164.999");
execution.setVariable("_sDmsKuemmerer", "111149924, 11884, 111190692, 111159137");
execution.setVariable("_anlagenDokumentSOZ", "");

//*****************************************************************
//GUID und Name für Protokoll setzen
execution.setVariable("_protokollDokumentCosysGUID", processconfig.getStatusDokument());
execution.setVariable("_protokollDateiName", execution.getVariable("_protokollName") + ".pdf");

//*****************************************************************
//User und Uhrzeit für Start setzen
var Vorname = user.firstname(execution.getVariable("starterOfInstance"));
var Name = user.lastname(execution.getVariable("starterOfInstance"));
var Ou = user.ou(execution.getVariable("starterOfInstance"));
execution.setVariable("StartEvent_SpontanmeldungNotwendig_complete_user_name", Vorname + " " + Name + ", " + Ou);

var date_now = new Date();
var month = '' + (date_now.getMonth() + 1);
var day = '' + date_now.getDate();
var year = 1900 + date_now.getYear();
        
if (month.length &lt; 2) 
   month = '0' + month;
if (day.length &lt; 2) 
   day = '0' + day;

var Datum = [day, month, year].join('.');

var hour = '' + (date_now.getHours());
var minutes = '' + (date_now.getMinutes());
var seconds =  '' + (date_now.getSeconds());

if (hour.length &lt; 2) 
   hour = '0' + hour;
if (minutes.length &lt; 2) 
   minutes = '0' + minutes;

var Zeit = [hour, minutes].join(':');

execution.setVariable('StartEvent_SpontanmeldungNotwendig_complete_time', Datum + " " + Zeit);</bpmn:script>
    </bpmn:scriptTask>
