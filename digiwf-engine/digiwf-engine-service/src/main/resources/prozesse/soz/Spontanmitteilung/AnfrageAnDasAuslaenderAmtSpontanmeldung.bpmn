    <bpmn:userTask id="Task_KVRSachbearbeitung_ZustaendigkeitPruefen" name="Zuständigkeit prüfen" camunda:asyncBefore="true" camunda:formKey="AnfrageAnDasAuslaenderAmtSpontanmeldung_ZustaendigkeitErmittelnFB_V1" camunda:candidateGroups="${kvrResponsibleGroup}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_groups">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_users">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_assignee">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_task_description">
            <camunda:script scriptFormat="Javascript">//TaskTitle aus Prozessvariablen zusammen bauen
task_title_ui = kvrResponsibleGroup;
if (FormField_AZR_Nummer) task_title_ui = task_title_ui + ", " + FormField_AZR_Nummer;
task_title_ui = task_title_ui + ", " + FormField_Name.toUpperCase() + ", " + FormField_Vorname;
if (FormField_Antwort_bis) task_title_ui = task_title_ui + ", Antwort bis: " + FormField_Antwort_bis__detail_format;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="ldapGroupMappingInput">${FormField_Zustaendigkeit}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="javascript">/**
if (task.execution.getVariable("_kvrSachbearbeitung") &amp;&amp; (task.execution.getVariable("_kvrSachbearbeitung") != "")) {
  task.setAssignee(task.execution.getVariable("_kvrSachbearbeitung"));
}*/

task.execution.setVariable("FormField_Zustaendigkeit_Alt", FormField_Zustaendigkeit);</camunda:script>
        </camunda:taskListener>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("_kvrSachbearbeitung", task.getAssignee());</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e4ob1b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q320jn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ZentraleStelle_ZustaendigkeitPruefen" name="Zuständigkeit prüfen" camunda:asyncBefore="true" camunda:formKey="AnfrageAnDasAuslaenderAmtSpontanmeldung_ZustaendigkeitErmittelnZS_V1" camunda:candidateGroups="KVR-II/311 ZS">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_groups">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_candidate_users">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_notification_send_assignee">false</camunda:inputParameter>
          <camunda:inputParameter name="digitalwf_task_description">
            <camunda:script scriptFormat="Javascript">//TaskTitle aus Prozessvariablen zusammen bauen
task_title_ui = "KVR-II/311 ZS";
if (FormField_AZR_Nummer) task_title_ui = task_title_ui + ", " + FormField_AZR_Nummer;
task_title_ui = task_title_ui + ", " + FormField_Name.toUpperCase() + ", " + FormField_Vorname;
if (FormField_Antwort_bis) task_title_ui = task_title_ui + ", Antwort bis: " + FormField_Antwort_bis__detail_format;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="ldapGroupMappingInput">${FormField_Zustaendigkeit}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="Javascript">if (FormField_ZustaendigkeitKVRII3 == "Value_Nein") task.execution.setVariable("_kvrSachbearbeitung", task.getAssignee());

task.execution.setVariable("FormField_BearbeitungPerPost", null);</camunda:script>
        </camunda:taskListener>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="Javascript">task.execution.setVariable("kvrResponsibleGroup", "KVR-II/311 ZS");</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
