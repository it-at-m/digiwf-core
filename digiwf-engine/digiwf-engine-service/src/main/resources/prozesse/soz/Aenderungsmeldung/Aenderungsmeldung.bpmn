    <bpmn:textAnnotation id="TextAnnotation_0rd788f">
      <bpmn:text>Dabei ist zu tun: Akte suchen, ggf. Akte anlegen, ggf. Vorgang anlegen (ohne LISSA-aktivitäts-Id,), Protokolldokument erzeugen udn ablegen, Anhänge aus dem KVR-DMS rüberkopieren.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
