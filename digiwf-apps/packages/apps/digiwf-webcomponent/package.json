{
  "name": "@muenchen/digiwf-webcomponent",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && npm run post-build",
    "post-build": "node ./processes/post-build.js",
    "preview": "vite preview",
    "lint": "prettier . --check && eslint . && vue-tsc -p tsconfig.app.json --noEmit --skipLibCheck --composite false",
    "fix": "prettier . --write && eslint . --fix"
  },
  "dependencies": {
    "@coreui/coreui": "~4.3.2",
    "@coreui/vue": "~4.10.2",
    "@jamescoyle/vue-icon": "~0.1.2",
    "@mdi/js": "~7.4.47",
    "@muenchen/digiwf-engine-api-internal": "~1.7.2",
    "@unplugin-vue-ce/sub-style": "~1.0.0-beta.19",
    "@vueuse/core": "~10.7.2",
    "vite-plugin-css-injected-by-js": "~3.3.1",
    "vue": "~3.4.10"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "~4.1.1",
    "@muenchen/prettier-codeformat": "~1.0.1",
    "@rushstack/eslint-patch": "~1.6.1",
    "@tsconfig/node18": "~18.2.2",
    "@types/node": "~20.11.0",
    "@typescript-eslint/eslint-plugin": "~6.18.1",
    "@vitejs/plugin-vue": "~5.0.3",
    "@vue/eslint-config-prettier": "~9.0.0",
    "@vue/eslint-config-typescript": "~12.0.0",
    "@vue/tsconfig": "~0.5.1",
    "eslint": "~8.56.0",
    "eslint-plugin-vue": "~9.20.0",
    "prettier": "~3.1.1",
    "sass": "~1.70.0",
    "typescript": "~5.3.3",
    "vite": "~5.0.11",
    "vue-tsc": "~1.8.27"
  }
}
