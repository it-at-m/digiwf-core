    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>DigiWF</title>
                            <footer>Code Coverage Report for DigiWF ${project.version}</footer>
<!--                            <includes>-->
<!--                                &lt;!&ndash; Analyze class files only to exclude shaded agent JAR from report &ndash;&gt;-->
<!--                                <include>**/*.class</include>-->
<!--                            </includes>-->
                            <outputDirectory>${project.build.directory}/coverage</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
